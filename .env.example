# Public (safe to ship in the browser bundle -- Next.js inlines any
# NEXT_PUBLIC_* variable into client code at build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK_AI=true

# Server-only. Never prefix these with NEXT_PUBLIC_ -- that would ship the
# service role key to every visitor's browser. Used by
# src/infrastructure/supabase/admin-client.ts (Next.js server code, guarded
# by `server-only`) and by scripts/embeddings/import.ts (plain Node script,
# run outside Next.js) for controlled local imports only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
