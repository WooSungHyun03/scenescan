# Public (safe to ship in the browser bundle -- Next.js inlines any
# NEXT_PUBLIC_* variable into client code at build time).
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase projects. This is browser-safe and RLS-scoped.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key fallback. Keep only while an existing project still uses it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public JavaScript key. Register localhost and production domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK_AI=true
# Optional experiment. Defaults to wasm; webgpu falls back to wasm if initialization fails.
NEXT_PUBLIC_CLIP_DEVICE=wasm

# Validation rules:
# - mock flags accept only true or false;
# - CLIP device accepts only wasm or webgpu;
# - when NEXT_PUBLIC_USE_MOCK_DATA=false, the URL and either the publishable
#   key or legacy anon key are required;
# - external URLs must use HTTPS (localhost/127.0.0.1 may use HTTP for local integration).
# Never create NEXT_PUBLIC_SUPABASE_SECRET_KEY or
# NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY. The build fails if either is populated.

# Server-only. Never prefix these with NEXT_PUBLIC_ -- that would ship the
# service role key to every visitor's browser. Used by
# src/infrastructure/supabase/admin-client.ts (including DELETE /api/account)
# and scripts/shared/supabase-admin-client.ts (Next.js server code is guarded
# by `server-only`) and by
# scripts/embeddings/import.ts (plain Node script, run outside Next.js) for
# controlled local imports only. SUPABASE_SECRET_KEY is Supabase's current
# API key name; SUPABASE_SERVICE_ROLE_KEY is accepted as a legacy fallback
# by both import scripts (SECRET_KEY takes priority if both are set).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only collection key for the official data.go.kr nationwide static
# parking API. Used only by `pnpm data:collect-parking`; never expose it as
# NEXT_PUBLIC_* or store it in committed files.
PUBLIC_DATA_PORTAL_SERVICE_KEY=

# Server-only key approved specifically for the KMA Village Forecast service
# (data.go.kr data/15084084). Approval for another public-data service key
# does not imply access to this API. Used by GET /api/locations/[id]/weather.
KMA_VILLAGE_FORECAST_SERVICE_KEY=
