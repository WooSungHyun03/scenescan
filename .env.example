# Public (safe to ship in the browser bundle -- Next.js inlines any
# NEXT_PUBLIC_* variable into client code at build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public JavaScript key. Register localhost and production domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK_AI=true
# Optional experiment. Defaults to wasm; webgpu falls back to wasm if initialization fails.
NEXT_PUBLIC_CLIP_DEVICE=wasm

# Server-only. Never prefix these with NEXT_PUBLIC_ -- that would ship the
# service role key to every visitor's browser. Used by
# src/infrastructure/supabase/admin-client.ts and scripts/shared/supabase-admin-client.ts
# (Next.js server code, guarded by `server-only`) and by
# scripts/embeddings/import.ts (plain Node script, run outside Next.js) for
# controlled local imports only. SUPABASE_SECRET_KEY is Supabase's current
# API key name; SUPABASE_SERVICE_ROLE_KEY is accepted as a legacy fallback
# by both import scripts (SECRET_KEY takes priority if both are set).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
