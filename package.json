{
  "name": "scenescan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "security:client-bundle": "node --experimental-strip-types scripts/security/assert-client-bundle-secrets.ts",
    "supabase:start": "npx --yes supabase@latest start",
    "supabase:stop": "npx --yes supabase@latest stop",
    "docker:build": "docker build -t scenescan:local .",
    "docker:up": "docker compose up --build",
    "data:collect-commons": "node --experimental-strip-types scripts/data/collect-commons.ts",
    "data:collect-parking": "node --experimental-strip-types scripts/data/collect-static-parking.ts",
    "data:collect-noise": "node --experimental-strip-types scripts/data/collect-static-noise-sources.ts",
    "data:discover-wikidata": "node --experimental-strip-types scripts/data/discover-wikidata.ts",
    "data:upload-storage": "node --experimental-strip-types scripts/data/upload-storage.ts",
    "data:import-production": "node --experimental-strip-types scripts/data/import-production.ts",
    "data:check-attribution-links": "node --experimental-strip-types scripts/data/check-attribution-links.ts",
    "data:normalize": "node --experimental-strip-types scripts/data/normalize.ts",
    "data:validate": "node --experimental-strip-types scripts/data/validate.ts",
    "data:import": "node --experimental-strip-types scripts/data/import.ts",
    "embeddings:prepare": "node --experimental-strip-types scripts/embeddings/prepare.ts",
    "embeddings:import": "node --experimental-strip-types scripts/embeddings/import.ts",
    "embeddings:audit-schema": "node --experimental-strip-types scripts/embeddings/audit-schema.ts",
    "embeddings:evaluate": "node --experimental-strip-types scripts/embeddings/evaluation.ts",
    "embeddings:evaluate-clip": "node --experimental-strip-types scripts/embeddings/clip-evaluate.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/suncalc": "^1.9.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
