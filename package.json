{
  "name": "scenescan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docker:build": "docker build -t scenescan:local .",
    "docker:up": "docker compose up --build",
    "data:normalize": "node --experimental-strip-types scripts/data/normalize.ts",
    "embeddings:prepare": "node --experimental-strip-types scripts/embeddings/prepare.ts",
    "embeddings:import": "node --experimental-strip-types scripts/embeddings/import.ts",
    "embeddings:audit-schema": "node --experimental-strip-types scripts/embeddings/audit-schema.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/suncalc": "^1.9.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
