# Values for `pnpm test:integration` against a local `pnpm supabase:start`
# instance. These are NOT secrets: they are Supabase CLI's well-known,
# publicly documented local-development defaults (derived from the fixed
# `jwt_secret = "super-secret-jwt-token-with-at-least-32-characters-long"`
# every `supabase init`-ed project ships with), valid only against
# 127.0.0.1 -- never used against a real deployed project. See
# docs/integration-testing.md.
#
# Source this file (or copy these into your shell) before running
# `pnpm test:integration`. Do not rename these -- they must exactly match
# the variables in .env.example, since the app's own repository/client code
# reads these same names.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
